generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SplitMethod {
  SHARES
  EXACT
}

enum GroupMemberRole {
  OWNER
  MEMBER
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String
  emailVerified Boolean       @default(false)
  image         String?
  isAnonymous   Boolean?      @default(false)

  memberships   GroupMember[]
  sessions      Session[]
  accounts      Account[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Group {
  id          String        @id @default(cuid())
  name        String
  description String?
  inviteCode  String        @unique @default(cuid()) 
  currency    String        @default("TWD") 

  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  createdById String
  updatedById String
}

model GroupMember {
  id   String          @id @default(cuid())
  name String
  role GroupMemberRole @default(MEMBER) 

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  isActive Boolean @default(true)

  expensePayments ExpensePayment[]
  expenseShares   ExpenseShare[]

  settlementsFrom Settlement[] @relation("SettlementFrom")
  settlementsTo   Settlement[] @relation("SettlementTo")

  createdById String
  updatedById String

  @@unique([groupId, userId]) 
  @@index([groupId])
  @@index([userId])
}

model Expense {
  id          String   @id @default(cuid())
  description String
  /// Amount in cents (integer). The display layer must always use `formatMoneyFromCents`.
  amountInCents Int @map("amount")
  date        DateTime
  note        String?
  category    String? 
  receiptUrl  String? 

  groupId String
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  splitMethod SplitMethod

  payments ExpensePayment[]
  shares   ExpenseShare[]

  deletedAt DateTime? 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  updatedById String

  @@index([groupId])
}

model ExpensePayment {
  id     String @id @default(cuid())
  /// The actual amount paid by this payer, in cents.
  amountInCents Int @map("amount")

  memberId String
  member   GroupMember @relation(fields: [memberId], references: [id])

  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, expenseId]) 
  @@index([memberId])
  @@index([expenseId])
}


model ExpenseShare {
  id    String @id @default(cuid())
  /// The owed/allocated amount for this member, in cents (calculated upon write/creation).
  amountInCents Int @map("value")

  memberId String
  member   GroupMember @relation(fields: [memberId], references: [id])

  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, expenseId]) 
  @@index([memberId])
  @@index([expenseId])
}

model Settlement {
  id     String   @id @default(cuid())
  /// Settlement amount, in cents.
  amountInCents Int @map("amount") 
  note   String?
  date   DateTime @default(now())

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  fromMemberId String
  fromMember   GroupMember @relation("SettlementFrom", fields: [fromMemberId], references: [id])

  toMemberId String
  toMember   GroupMember @relation("SettlementTo", fields: [toMemberId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  updatedById String

  @@index([groupId])
  @@index([fromMemberId])
  @@index([toMemberId])
}

// From Better Auth

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
