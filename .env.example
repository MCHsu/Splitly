# Connect via pooler (recommended for app/runtime queries)
DATABASE_URL="postgresql://user:password@localhost:5432/splitly"

# Direct database connection (used by Prisma migrations)
DIRECT_URL="postgresql://user:password@localhost:5432/splitly"

# Secret used by better-auth to sign sessions/tokens (generate with `openssl rand -base64 32`)
BETTER_AUTH_SECRET=

# Base URL of your app (used by better-auth server)
BETTER_AUTH_URL="http://localhost:3000"

# Base URL used by the client (better-auth react client), must match the deployed domain in production
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed users (used by prisma db seed)
SEED_ALEX_EMAIL="alex123@example.com"
SEED_ALEX_PASSWORD="User#Alex123"
SEED_EMILY_EMAIL="emily456@example.com"
SEED_EMILY_PASSWORD="User#Emily456"
